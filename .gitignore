# Credentials - never commit these
kaggle.json
.kaggle/
*.pem
*.key
.env

# Run outputs / checkpoints (large, gitignored)
results/checkpoints/**
results/archive/**
archive/**
results.json
# Method training outputs
methods/*/results/*.pth
methods/*/results/*.npy
# Kaggle run folders: ignore everything except the final multi-dataset results
results/kaggle_runs/*
!results/kaggle_runs/multidataset/
results/kaggle_runs/multidataset/*
!results/kaggle_runs/multidataset/out/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Large files - PDFs (use Git LFS or download separately)
papers/**/*.pdf
*.pdf

# Excel outputs (generated by scripts)
*.xlsx

# Data files too large for git
*.mat
*.h5
*.hdf5
*.tif
*.tiff

# Kaggle
.kaggle/

kaggle_logs/
