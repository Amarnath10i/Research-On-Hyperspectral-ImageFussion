# Credentials - never commit these
kaggle.json
.kaggle/
*.pem
*.key
.env

# Papers: subscription PDFs are kept locally only; citations and links are in docs/
literature/
*.pdf

# Model weights and binaries stay local (retrain, or get them from the upstream baseline repos)
*.pth
*.pth.tar
*.pt
*.ckpt
*.whl
*.bin
*.npy
*.npz

# Data files too large for git
*.mat
*.h5
*.hdf5
*.tif
*.tiff

# Run outputs
kaggle_logs/
results.json
!results/puformer_chikusei_x4/*/results.json
!results/puformer_chikusei_x4_v3/*/results.json
methods/*/out/
# Kaggle run folders: ignore everything except the final multi-dataset results
results/kaggle_runs/*
!results/kaggle_runs/multidataset/
results/kaggle_runs/multidataset/*
!results/kaggle_runs/multidataset/out/

# Python / Jupyter / envs
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
.ipynb_checkpoints/
.venv/
venv/
env/

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Excel outputs (generated by scripts)
*.xlsx
